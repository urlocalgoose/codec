# Codec sync server
#
# Generate a long random value before exposing the server:
#   openssl rand -base64 48

CODEC_AUTH_TOKEN=
CODEC_SERVER_ADDR=:8787
CODEC_DATA_DIR=./sync-server/codec-sync-data
CODEC_WEB_DIR=./build

# Backwards-compatible alias. Prefer CODEC_AUTH_TOKEN for new installs.
LOUD_AUTH_TOKEN=

# Optional importer helper settings for scripts/codec-add.sh.
CODEC_MUSIC_ROOT=
CODEC_SERVER_URL=http://127.0.0.1:8787
CODEC_AUTH_TOKEN_FILE=$HOME/.codec/auth-token
CODEC_IMPORT_BIN=$HOME/.codec/bin/codec_import
S2Y_DIR=
S2Y_WORKERS=8
SPOTIFY_CLIENT_ID=
