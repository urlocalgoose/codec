{
  "name": "codec",
  "version": "0.1.0",
  "description": "Self-hosted music server and web player with an iPhone and iPad client.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:mobile": "bun run local:up",
    "server:dev": "bun run local:up",
    "server": "bun run local:up",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "gen:ios-themes": "bun scripts/generate-ios-themes.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun run test:frontend && bun run test:rust",
    "test:frontend": "bun test",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "test:server": "cd sync-server && go test ./...",
    "test:server:race": "cd sync-server && go test -race ./...",
    "test:schemas": "python3 scripts/test-import-schema.py",
    "release:server": "python3 scripts/build-server-release.py",
    "check:quick": "python3 scripts/check-quick.py",
    "local:up": "python3 scripts/local-dev.py up",
    "local:stop": "python3 scripts/local-dev.py stop",
    "local:status": "python3 scripts/local-dev.py status",
    "local:auth": "python3 scripts/local-dev.py auth",
    "local:check": "python3 scripts/local-dev.py check",
    "local:share": "python3 scripts/local-dev.py share",
    "local:unshare": "python3 scripts/local-dev.py unshare",
    "local:ios": "python3 scripts/local-test-app.py"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "lucide-svelte": "^1.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  },
  "packageManager": "bun@1.3.13"
}
